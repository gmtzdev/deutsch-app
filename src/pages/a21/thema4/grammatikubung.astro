---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA21 from "@/components/ActivitesListA21.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA21 open={4} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik&uuml;bung</h1>
                <p class="subtitle text-indications">
                    Indefinitpronomen &mdash; F&uuml;llen Sie die L&uuml;cken aus.
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <!-- Word bank -->
                        <div class="wordbank">
                            <span class="wb-label">W&ouml;rterkasten:</span>
                            <span class="wb-chip chip-jem">Jemand</span>
                            <span class="wb-chip chip-jem">jemanden</span>
                            <span class="wb-chip chip-man">man</span>
                            <span class="wb-chip chip-nie">niemand</span>
                        </div>

                        <!-- Text with blanks -->
                        <div class="text-block">
                            <p class="story">
                                Ich habe einem verletzten Mann geholfen.
                                <input class="ipt ipt-lg" data-ans="Jemand" placeholder="__________" />,
                                der vorbeilief, wollte helfen, und ich habe mich daf&uuml;r entschieden,
                                <input class="ipt ipt-md" data-ans="jemanden" placeholder="__________" />
                                zu fragen, ob er den Krankenwagen anrufen kann.
                                Zum Gl&uuml;ck kann
                                <input class="ipt ipt-sm" data-ans="man" placeholder="_____" />
                                noch an die Menschheit glauben und es gab
                                <input class="ipt ipt-md" data-ans="niemand" placeholder="__________" />,
                                der mir geholfen hat, dem Mann zu helfen.
                            </p>
                        </div>

                        <div class="btn-row">
                            <button id="btnCheck" class="btn-check">Pr&uuml;fen</button>
                            <button id="btnSolution" class="btn-solution">L&ouml;sung zeigen</button>
                            <button id="btnReset" class="btn-reset">Zur&uuml;cksetzen</button>
                        </div>

                        <div id="result" class="result hidden"></div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1.2rem; }

        /* Word bank */
        .wordbank {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.65rem 1rem;
        }
        .wb-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-right: 0.25rem;
        }
        .wb-chip {
            display: inline-block;
            padding: 0.2rem 0.65rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.88rem;
        }
        .chip-man { background: #dbeafe; color: #1d4ed8; border: 1.5px solid #93c5fd; }
        .chip-jem { background: #ede9fe; color: #6d28d9; border: 1.5px solid #c4b5fd; }
        .chip-nie { background: #fee2e2; color: #b91c1c; border: 1.5px solid #fca5a5; }

        /* Story text */
        .text-block {
            background: #fff;
            border: 1.5px solid #e5e7eb;
            border-radius: 12px;
            padding: 1.2rem 1.4rem;
        }
        .story {
            font-size: 1rem;
            line-height: 2.2;
            color: #111827;
            margin: 0;
        }

        /* Inputs */
        .ipt {
            border: none;
            border-bottom: 2px solid #a78bfa;
            background: transparent;
            outline: none;
            font-size: 1rem;
            font-family: inherit;
            color: #6d28d9;
            font-weight: 700;
            padding: 0.05rem 0.25rem;
            text-align: center;
            transition: border-color 0.2s;
            vertical-align: baseline;
        }
        .ipt:focus { border-bottom-color: #7c3aed; }
        .ipt-sm { width: 4rem; }
        .ipt-md { width: 7.5rem; }
        .ipt-lg { width: 7.5rem; }

        .ipt.correct   { border-bottom-color: #16a34a; color: #15803d; background: #f0fdf4; border-radius: 3px; }
        .ipt.incorrect { border-bottom-color: #dc2626; color: #b91c1c; background: #fef2f2; border-radius: 3px; }
        .ipt.shown     { border-bottom-color: #d97706; color: #b45309; background: #fffbeb; border-radius: 3px; }

        /* Buttons */
        .btn-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.25rem; }

        .btn-check {
            padding: 0.5rem 1.4rem;
            background: #7c3aed;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-check:hover { background: #6d28d9; }

        .btn-solution {
            padding: 0.5rem 1.2rem;
            background: transparent;
            color: #d97706;
            border: 1.5px solid #fcd34d;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-solution:hover { background: #fffbeb; }

        .btn-reset {
            padding: 0.5rem 1.2rem;
            background: transparent;
            color: #6b7280;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-reset:hover { border-color: #9ca3af; color: #374151; }

        /* Result */
        .result { padding: 0.7rem 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 700; }
        .result.hidden { display: none; }
        .result.ok  { background: #f0fdf4; color: #15803d; border: 1.5px solid #86efac; }
        .result.err { background: #fef2f2; color: #991b1b; border: 1.5px solid #fca5a5; }
    </style>

    <script>
        const inputs = document.querySelectorAll<HTMLInputElement>(".ipt");
        const btnCheck    = document.getElementById("btnCheck")!;
        const btnSolution = document.getElementById("btnSolution")!;
        const btnReset    = document.getElementById("btnReset")!;
        const result      = document.getElementById("result")!;

        btnCheck.addEventListener("click", () => {
            let correct = 0;
            inputs.forEach(inp => {
                const ans = (inp.dataset.ans ?? "").trim().toLowerCase();
                const val = inp.value.trim().toLowerCase();
                inp.classList.remove("shown");
                if (val === ans) {
                    inp.classList.add("correct");
                    inp.classList.remove("incorrect");
                    correct++;
                } else {
                    inp.classList.add("incorrect");
                    inp.classList.remove("correct");
                }
            });
            result.classList.remove("hidden", "ok", "err");
            if (correct === inputs.length) {
                result.textContent = `Perfekt! Alle ${inputs.length} Antworten richtig!`;
                result.classList.add("ok");
            } else {
                result.textContent = `${correct} von ${inputs.length} richtig. Versuche es nochmal!`;
                result.classList.add("err");
            }
        });

        btnSolution.addEventListener("click", () => {
            inputs.forEach(inp => {
                inp.value = inp.dataset.ans ?? "";
                inp.classList.remove("correct", "incorrect");
                inp.classList.add("shown");
            });
            result.classList.add("hidden");
        });

        btnReset.addEventListener("click", () => {
            inputs.forEach(inp => {
                inp.value = "";
                inp.classList.remove("correct", "incorrect", "shown");
            });
            result.classList.add("hidden");
            result.classList.remove("ok", "err");
        });
    </script>
</Layout>