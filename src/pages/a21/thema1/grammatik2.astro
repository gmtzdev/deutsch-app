---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA21 from "@/components/ActivitesListA21.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";

const examples = [
    "Das Kind wurde von der Mutter gerufen.",
    "Carlo ist vom Balkon gefallen.",
    "Was hast du von deinen Eltern / Freunden / Gro\u00dfeltern bekommen?",
    "Was geh\u00f6rt jetzt dir?",
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA21 open={1} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik 2</h1>
                <p class="subtitle text-indications">
                    Pr&auml;position <em>von</em> + Dativ &mdash; Kontraktion
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <!-- Contraction rule -->
                        <div class="rule-box">
                            <p class="rule-label">Kontraktion</p>
                            <div class="contraction-row">
                                <span class="part part-prep">von</span>
                                <span class="plus">+</span>
                                <span class="part part-art">dem</span>
                                <span class="arrow">=</span>
                                <span class="part part-result">vom</span>
                            </div>
                            <p class="rule-note">
                                Nur mit <strong>dem</strong> (Maskulin &amp; Neutrum, Dativ).
                                Mit <em>der</em> (Feminin) oder <em>den</em> (Plural) keine Kontraktion.
                            </p>
                        </div>

                        <!-- Comparison table -->
                        <div class="table-wrapper">
                            <table class="vocab-table von-table">
                                <thead>
                                    <tr>
                                        <th class="th-gen">Genus</th>
                                        <th class="th-full">Vollform</th>
                                        <th class="th-short">Kurzform</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="row-even">
                                        <td class="td-gen gen-mf">Maskulin / Neutrum</td>
                                        <td class="td-full">von dem Balkon<br />von dem Kind</td>
                                        <td class="td-short"><span class="chip-result">vom</span> Balkon<br /><span class="chip-result">vom</span> Kind</td>
                                    </tr>
                                    <tr class="row-odd">
                                        <td class="td-gen gen-f">Feminin</td>
                                        <td class="td-full">von der Mutter</td>
                                        <td class="td-short"><span class="chip-none">von der</span> Mutter</td>
                                    </tr>
                                    <tr class="row-even">
                                        <td class="td-gen gen-pl">Plural</td>
                                        <td class="td-full">von den Eltern</td>
                                        <td class="td-short"><span class="chip-none">von den</span> Eltern</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Examples -->
                        <div class="examples-box">
                            <p class="examples-label">Beispiele</p>
                            <ol class="ex-list">
                                {examples.map((ex) => (
                                    <li>{ex}</li>
                                ))}
                            </ol>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1.25rem; }

        /* Rule box */
        .rule-box {
            border: 2px solid #bfdbfe;
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            background: #eff6ff;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            align-items: flex-start;
        }
        .rule-label {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #1d4ed8;
            margin: 0;
        }
        .contraction-row {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
        }
        .part {
            display: inline-block;
            padding: 0.3rem 0.9rem;
            border-radius: 10px;
            font-size: 1.15rem;
            font-weight: 800;
        }
        .part-prep   { background: #dbeafe; color: #1e40af; border: 1.5px solid #93c5fd; }
        .part-art    { background: #e0e7ff; color: #4338ca; border: 1.5px solid #a5b4fc; }
        .part-result { background: #1d4ed8; color: #fff; font-size: 1.3rem; padding: 0.3rem 1.1rem; }
        .plus, .arrow { font-size: 1.3rem; font-weight: 800; color: #6b7280; }
        .rule-note   { font-size: 0.85rem; color: #374151; margin: 0; }

        /* Table */
        .table-wrapper { overflow-x: auto; }
        .th-gen   { width: 180px; }
        .th-full  { width: 45%; }
        .th-short { }
        .td-gen   { font-weight: 700; font-size: 0.88rem; vertical-align: middle; padding: 0.85rem 0.75rem; }
        .td-full  { color: #6b7280; font-size: 0.92rem; vertical-align: middle; padding: 0.85rem 0.75rem; }
        .td-short { font-size: 0.92rem; vertical-align: middle; padding: 0.85rem 0.75rem; }

        .gen-mf { color: #1d4ed8; }
        .gen-f  { color: #7c3aed; }
        .gen-pl { color: #c2410c; }

        .chip-result {
            display: inline-block;
            background: #1d4ed8;
            color: #fff;
            padding: 0.1rem 0.5rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.85rem;
        }
        .chip-none {
            display: inline-block;
            background: #f3f4f6;
            color: #374151;
            padding: 0.1rem 0.5rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            border: 1px solid #d1d5db;
        }

        /* Examples */
        .examples-box {
            border: 1.5px solid #e5e7eb;
            border-radius: 12px;
            padding: 1rem 1.25rem;
            background: #fafafa;
        }
        .examples-label {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #6b7280;
            margin: 0 0 0.6rem;
        }
        .ex-list {
            list-style: decimal inside;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }
        .ex-list li { font-size: 0.95rem; line-height: 1.6; }
    </style>
</Layout>