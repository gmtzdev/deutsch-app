---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA21 from "@/components/ActivitesListA21.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA21 open={1} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik&uuml;bung 3</h1>
                <p class="subtitle text-indications">
                    Schreiben Sie &uuml;ber Ihre Familie &mdash; Responda con frases completas.
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <!-- Mini hint -->
                        <div class="hint-box">
                            <p class="hint-title">Tipp</p>
                            <p>
                                Erg&auml;nzen Sie den Possessivartikel (<strong>Ihre / meine</strong>) und
                                antworten Sie dann mit einem vollst&auml;ndigen Satz.
                            </p>
                        </div>

                        <div class="exercises">

                            <!-- 1 -->
                            <div class="ex-block">
                                <div class="ex-row">
                                    <span class="ex-num">1.</span>
                                    <div class="question">
                                        Wie hei&szlig;t
                                        <input class="ipt ipt-md" data-ans="Ihre" placeholder="______" />
                                        Mutter?
                                    </div>
                                </div>
                                <textarea class="free-answer" placeholder="Meine Mutter hei&szlig;t ..."></textarea>
                            </div>

                            <!-- 2 -->
                            <div class="ex-block">
                                <div class="ex-row">
                                    <span class="ex-num">2.</span>
                                    <div class="question">
                                        Wie hei&szlig;t
                                        <input class="ipt ipt-md" data-ans="Ihr" placeholder="______" />
                                        Vater?
                                    </div>
                                </div>
                                <textarea class="free-answer" placeholder="Mein Vater hei&szlig;t ..."></textarea>
                            </div>

                            <!-- 3 -->
                            <div class="ex-block">
                                <div class="ex-row">
                                    <span class="ex-num">3.</span>
                                    <div class="question">
                                        Haben Sie Geschwister? Wie hei&szlig;en
                                        <input class="ipt ipt-md" data-ans="Ihre" placeholder="______" />
                                        Geschwister?
                                    </div>
                                </div>
                                <textarea class="free-answer" placeholder="Ich habe ... Geschwister. Sie hei&szlig;en ..."></textarea>
                            </div>

                            <!-- 4 -->
                            <div class="ex-block">
                                <div class="ex-row">
                                    <span class="ex-num">4.</span>
                                    <div class="question">
                                        Haben Sie Cousins oder Cousinen?
                                    </div>
                                </div>
                                <textarea class="free-answer" placeholder="Ja, ich habe ... / Nein, ich habe keine ..."></textarea>
                            </div>

                            <!-- 5 -->
                            <div class="ex-block">
                                <div class="ex-row">
                                    <span class="ex-num">5.</span>
                                    <div class="question">
                                        Ist
                                        <input class="ipt ipt-md" data-ans="Ihre" placeholder="______" />
                                        Familie gro&szlig; oder klein?
                                    </div>
                                </div>
                                <textarea class="free-answer" placeholder="Meine Familie ist ..."></textarea>
                            </div>

                        </div>

                        <div class="btn-row">
                            <button id="btnCheck" class="btn-check">Pr&uuml;fen</button>
                            <button id="btnSolution" class="btn-solution">L&ouml;sung zeigen</button>
                            <button id="btnReset" class="btn-reset">Zur&uuml;cksetzen</button>
                        </div>

                        <div id="result" class="result hidden"></div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1.2rem; }

        /* Hint */
        .hint-box {
            background: #fffbeb;
            border: 1.5px solid #fcd34d;
            border-radius: 10px;
            padding: 0.75rem 1.1rem;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        .hint-title {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #b45309;
            margin: 0;
        }
        .hint-box p:last-child { font-size: 0.88rem; margin: 0; color: #374151; }

        /* Exercises */
        .exercises { display: flex; flex-direction: column; gap: 1.25rem; }

        .ex-block {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            background: #f9fafb;
            border: 1.5px solid #e5e7eb;
            border-radius: 12px;
            padding: 0.9rem 1.1rem;
        }

        .ex-row {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .ex-num {
            min-width: 1.5rem;
            font-weight: 700;
            color: #374151;
            font-size: 0.95rem;
            flex-shrink: 0;
        }
        .question {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.35rem;
            font-size: 0.97rem;
            font-weight: 600;
            color: #111827;
        }

        /* Fill-in input */
        .ipt {
            border: none;
            border-bottom: 2px solid #93c5fd;
            background: transparent;
            outline: none;
            font-size: 0.97rem;
            font-family: inherit;
            color: #1d4ed8;
            font-weight: 700;
            padding: 0.05rem 0.2rem;
            text-align: center;
            transition: border-color 0.2s;
        }
        .ipt:focus { border-bottom-color: #2563eb; }
        .ipt-md { width: 5.5rem; }

        .ipt.correct   { border-bottom-color: #16a34a; color: #15803d; background: #f0fdf4; border-radius: 3px; }
        .ipt.incorrect { border-bottom-color: #dc2626; color: #b91c1c; background: #fef2f2; border-radius: 3px; }
        .ipt.shown     { border-bottom-color: #d97706; color: #b45309; background: #fffbeb; border-radius: 3px; }

        /* Free answer textarea */
        .free-answer {
            width: 100%;
            min-height: 60px;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            padding: 0.55rem 0.75rem;
            font-size: 0.92rem;
            font-family: inherit;
            color: #111827;
            background: #fff;
            resize: vertical;
            outline: none;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }
        .free-answer:focus { border-color: #60a5fa; }

        /* Buttons */
        .btn-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.25rem; }

        .btn-check {
            padding: 0.5rem 1.4rem;
            background: #1d4ed8;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-check:hover { background: #1e40af; }

        .btn-solution {
            padding: 0.5rem 1.2rem;
            background: transparent;
            color: #d97706;
            border: 1.5px solid #fcd34d;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-solution:hover { background: #fffbeb; }

        .btn-reset {
            padding: 0.5rem 1.2rem;
            background: transparent;
            color: #6b7280;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-reset:hover { border-color: #9ca3af; color: #374151; }

        /* Result */
        .result { padding: 0.7rem 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 700; }
        .result.hidden { display: none; }
        .result.ok  { background: #f0fdf4; color: #15803d; border: 1.5px solid #86efac; }
        .result.err { background: #fef2f2; color: #991b1b; border: 1.5px solid #fca5a5; }
    </style>

    <script>
        const inputs = document.querySelectorAll<HTMLInputElement>(".ipt");
        const btnCheck    = document.getElementById("btnCheck")!;
        const btnSolution = document.getElementById("btnSolution")!;
        const btnReset    = document.getElementById("btnReset")!;
        const result      = document.getElementById("result")!;

        btnCheck.addEventListener("click", () => {
            let correct = 0;
            inputs.forEach(inp => {
                const ans = (inp.dataset.ans ?? "").trim().toLowerCase();
                const val = inp.value.trim().toLowerCase();
                inp.classList.remove("shown");
                if (val === ans) {
                    inp.classList.add("correct");
                    inp.classList.remove("incorrect");
                    correct++;
                } else {
                    inp.classList.add("incorrect");
                    inp.classList.remove("correct");
                }
            });
            result.classList.remove("hidden", "ok", "err");
            if (correct === inputs.length) {
                result.textContent = `Perfekt! Alle ${inputs.length} Antworten richtig!`;
                result.classList.add("ok");
            } else {
                result.textContent = `${correct} von ${inputs.length} richtig. Versuche es nochmal!`;
                result.classList.add("err");
            }
        });

        btnSolution.addEventListener("click", () => {
            inputs.forEach(inp => {
                inp.value = inp.dataset.ans ?? "";
                inp.classList.remove("correct", "incorrect");
                inp.classList.add("shown");
            });
            result.classList.add("hidden");
        });

        btnReset.addEventListener("click", () => {
            inputs.forEach(inp => {
                inp.value = "";
                inp.classList.remove("correct", "incorrect", "shown");
            });
            document.querySelectorAll<HTMLTextAreaElement>(".free-answer").forEach(ta => ta.value = "");
            result.classList.add("hidden");
            result.classList.remove("ok", "err");
        });
    </script>
</Layout>