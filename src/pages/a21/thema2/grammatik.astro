---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA21 from "@/components/ActivitesListA21.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";

const rows = [
    {
        prep: "an",
        wohin: "Sandra haengt das Bild an die Wand.",
        wo:    "Jetzt haengt das Bild an der Wand.",
    },
    {
        prep: "auf",
        wohin: "Samir legt das Buch auf den Tisch.",
        wo:    "Jetzt liegt das Buch auf dem Tisch.",
    },
    {
        prep: "hinter",
        wohin: "Giuseppe stellt sich hinter den Stuhl.",
        wo:    "Jetzt steht Guido hinter dem Stuhl.",
    },
    {
        prep: "in",
        wohin: "Jose steckt das Geld in die Tasche.",
        wo:    "Das Geld ist jetzt in der Tasche.",
    },
    {
        prep: "neben",
        wohin: "Karim setzt sich neben Michaela.",
        wo:    "Jetzt sitzt Klaus neben ihr.",
    },
    {
        prep: "ueber",
        wohin: "Sie haengt die Lampe ueber den Tisch.",
        wo:    "Jetzt haengt sie ueber dem Tisch.",
    },
    {
        prep: "unter",
        wohin: "Die Katze legt sich unter den Tisch.",
        wo:    "Jetzt liegt die Katze unter dem Tisch.",
    },
    {
        prep: "vor",
        wohin: "Olaf stellt sich vor das Fenster.",
        wo:    "Jetzt steht er vor dem Fenster.",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA21 open={2} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik</h1>
                <p class="subtitle text-indications">
                    Wechselpr&auml;positionen — Akkusativ &amp; Dativ
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <!-- Legend pills -->
                        <div class="legend">
                            <span class="pill pill-akk">wohin? + Akkusativ</span>
                            <span class="pill pill-dat">wo? + Dativ</span>
                        </div>

                        <div class="table-wrapper">
                            <table class="vocab-table prep-table">
                                <thead>
                                    <tr>
                                        <th class="th-prep">Pr&auml;position</th>
                                        <th class="th-akk">wohin? + Akkusativ</th>
                                        <th class="th-dat">wo? + Dativ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {rows.map((r) => (
                                        <tr>
                                            <td class="td-prep">{r.prep === "ueber" ? "über" : r.prep === "ueber" ? "über" : r.prep}</td>
                                            <td class="td-akk">{r.wohin.replace("haengt","hängt").replace("ueber","über").replace("haengt","hängt")}</td>
                                            <td class="td-dat">{r.wo.replace("haengt","hängt").replace("ueber","über")}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1rem; }

        .legend {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .pill {
            display: inline-block;
            padding: 0.2rem 0.75rem;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.03em;
        }

        .pill-akk { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }
        .pill-dat { background: #dcfce7; color: #166534; border: 1px solid #86efac; }

        .table-wrapper { overflow-x: auto; }

        /* Column widths */
        .th-prep { width: 90px; }
        .th-akk, .th-dat { width: 50%; }

        /* Coloured sub-headers */
        .th-akk {
            background: #dbeafe !important;
            color: #1e40af !important;
            border-bottom: 2px solid #93c5fd !important;
        }

        .th-dat {
            background: #dcfce7 !important;
            color: #15803d !important;
            border-bottom: 2px solid #86efac !important;
        }

        /* Präposition cell */
        .td-prep {
            font-weight: 800;
            font-size: 1rem;
            color: #374151;
            white-space: nowrap;
            border-right: 2px solid var(--color-table-row-border, #e5e7eb);
        }

        /* Akkusativ cell */
        .td-akk { color: #1e40af; font-size: 0.88rem; }

        /* Dativ cell */
        .td-dat { color: #166534; font-size: 0.88rem; }
    </style>
</Layout>