---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA12 from "@/components/ActivitesListA12.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA12 open={7} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik&uuml;bung 2</h1>
                <p class="subtitle text-indications">
                    Trennbare Verben &mdash; Erg&auml;nzen Sie das richtige Pr&auml;fix!
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <!-- Word bank -->
                        <div class="wordbank">
                            <span class="wb-label">Pr&auml;fixe:</span>
                            <span class="wb-chip">auf</span>
                            <span class="wb-chip">an</span>
                            <span class="wb-chip">nach</span>
                            <span class="wb-chip">an</span>
                            <span class="wb-chip">zu</span>
                        </div>

                        <div class="exercises">

                            <!-- 1: nachgedacht — prefix fused before past participle -->
                            <div class="ex-row">
                                <span class="ex-num">1.</span>
                                <div class="sentence">
                                    Ich habe lange
                                    <span class="fused">
                                        <input class="ipt ipt-sm" data-ans="nach" placeholder="____" /><span class="fused-rest">gedacht.</span>
                                    </span>
                                </div>
                            </div>

                            <!-- 2: aufmachen — prefix at end -->
                            <div class="ex-row">
                                <span class="ex-num">2.</span>
                                <div class="sentence">
                                    Ich mache die T&uuml;r
                                    <input class="ipt ipt-sm" data-ans="auf" placeholder="____" />.
                                </div>
                            </div>

                            <!-- 3: zumachen — prefix at end -->
                            <div class="ex-row">
                                <span class="ex-num">3.</span>
                                <div class="sentence">
                                    Ich mache die T&uuml;r
                                    <input class="ipt ipt-sm" data-ans="zu" placeholder="____" />.
                                </div>
                            </div>

                            <!-- 4: ansehen — prefix at end -->
                            <div class="ex-row">
                                <span class="ex-num">4.</span>
                                <div class="sentence">
                                    Ich sehe mir die Doku
                                    <input class="ipt ipt-sm" data-ans="an" placeholder="____" />.
                                </div>
                            </div>

                            <!-- 5: angeworben — prefix fused before past participle -->
                            <div class="ex-row">
                                <span class="ex-num">5.</span>
                                <div class="sentence">
                                    Patrizia hat sich bei uns
                                    <span class="fused">
                                        <input class="ipt ipt-sm" data-ans="an" placeholder="____" /><span class="fused-rest">geworben.</span>
                                    </span>
                                </div>
                            </div>

                        </div>

                        <div class="btn-row">
                            <button id="btnCheck" class="btn-check">Pr&uuml;fen</button>
                            <button id="btnSolution" class="btn-solution">L&ouml;sung zeigen</button>
                            <button id="btnReset" class="btn-reset">Zur&uuml;cksetzen</button>
                        </div>

                        <div id="result" class="result hidden"></div>

                        <!-- Hint box -->
                        <div class="hint-box">
                            <p class="hint-title">Tipp</p>
                            <p>
                                Bei trennbaren Verben steht das Pr&auml;fix im Pr&auml;sens am <strong>Satzende</strong>.
                                Im Perfekt wird <em>ge-</em> zwischen Pr&auml;fix und Verbstamm eingef&uuml;gt:
                                <span class="eg"><strong>nach</strong>&middot;ge&middot;dacht, <strong>an</strong>&middot;ge&middot;worben</span>.
                            </p>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1.2rem; }

        /* Word bank */
        .wordbank {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.65rem 1rem;
        }
        .wb-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-right: 0.25rem;
        }
        .wb-chip {
            display: inline-block;
            padding: 0.2rem 0.65rem;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.88rem;
            background: #1d4ed8;
            color: #fff;
        }

        /* Exercises */
        .exercises { display: flex; flex-direction: column; gap: 0.85rem; }

        .ex-row {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .ex-num {
            min-width: 1.5rem;
            font-weight: 700;
            color: #374151;
            font-size: 0.95rem;
        }
        .sentence {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.35rem;
            font-size: 0.97rem;
            color: #111827;
        }

        /* Fused: input + suffix glued together */
        .fused {
            display: inline-flex;
            align-items: baseline;
        }
        .fused-rest {
            font-size: 0.97rem;
            color: #111827;
            font-weight: 600;
        }

        /* Input */
        .ipt {
            border: none;
            border-bottom: 2px solid #93c5fd;
            background: transparent;
            outline: none;
            font-size: 0.97rem;
            font-family: inherit;
            color: #1d4ed8;
            font-weight: 800;
            padding: 0.05rem 0.2rem;
            text-align: center;
            transition: border-color 0.2s;
        }
        .ipt:focus { border-bottom-color: #2563eb; }
        .ipt-sm { width: 4rem; }

        .ipt.correct   { border-bottom-color: #16a34a; color: #15803d; background: #f0fdf4; border-radius: 3px; }
        .ipt.incorrect { border-bottom-color: #dc2626; color: #b91c1c; background: #fef2f2; border-radius: 3px; }
        .ipt.shown     { border-bottom-color: #d97706; color: #b45309; background: #fffbeb; border-radius: 3px; }

        /* Buttons */
        .btn-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.25rem; }

        .btn-check {
            padding: 0.5rem 1.4rem;
            background: #1d4ed8;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-check:hover { background: #1e40af; }

        .btn-solution {
            padding: 0.5rem 1.2rem;
            background: transparent;
            color: #d97706;
            border: 1.5px solid #fcd34d;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-solution:hover { background: #fffbeb; }

        .btn-reset {
            padding: 0.5rem 1.2rem;
            background: transparent;
            color: #6b7280;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-reset:hover { border-color: #9ca3af; color: #374151; }

        /* Result */
        .result { padding: 0.7rem 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 700; }
        .result.hidden { display: none; }
        .result.ok  { background: #f0fdf4; color: #15803d; border: 1.5px solid #86efac; }
        .result.err { background: #fef2f2; color: #991b1b; border: 1.5px solid #fca5a5; }

        /* Hint */
        .hint-box {
            background: #fffbeb;
            border: 1.5px solid #fcd34d;
            border-radius: 10px;
            padding: 0.8rem 1.1rem;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        .hint-title {
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #b45309;
            margin: 0;
        }
        .hint-box p:last-child { font-size: 0.88rem; margin: 0; color: #374151; }
        .eg { font-style: italic; }
    </style>

    <script>
        const inputs = document.querySelectorAll<HTMLInputElement>(".ipt");
        const btnCheck    = document.getElementById("btnCheck")!;
        const btnSolution = document.getElementById("btnSolution")!;
        const btnReset    = document.getElementById("btnReset")!;
        const result      = document.getElementById("result")!;

        btnCheck.addEventListener("click", () => {
            let correct = 0;
            inputs.forEach(inp => {
                const ans = (inp.dataset.ans ?? "").trim().toLowerCase();
                const val = inp.value.trim().toLowerCase();
                inp.classList.remove("shown");
                if (val === ans) {
                    inp.classList.add("correct");
                    inp.classList.remove("incorrect");
                    correct++;
                } else {
                    inp.classList.add("incorrect");
                    inp.classList.remove("correct");
                }
            });
            result.classList.remove("hidden", "ok", "err");
            if (correct === inputs.length) {
                result.textContent = `Perfekt! Alle ${inputs.length} Antworten richtig!`;
                result.classList.add("ok");
            } else {
                result.textContent = `${correct} von ${inputs.length} richtig. Versuche es nochmal!`;
                result.classList.add("err");
            }
        });

        btnSolution.addEventListener("click", () => {
            inputs.forEach(inp => {
                inp.value = inp.dataset.ans ?? "";
                inp.classList.remove("correct", "incorrect");
                inp.classList.add("shown");
            });
            result.classList.add("hidden");
        });

        btnReset.addEventListener("click", () => {
            inputs.forEach(inp => {
                inp.value = "";
                inp.classList.remove("correct", "incorrect", "shown");
            });
            result.classList.add("hidden");
            result.classList.remove("ok", "err");
        });
    </script>
</Layout>