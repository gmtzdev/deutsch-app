---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA12 from "@/components/ActivitesListA12.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA12 open={2} />

        <main class="page bg-background">
            <Card>
                <h1>Ziel</h1>
                <p class="subtitle text-indications">
                    Al final de esta unidad podrás saludar, presentarte y
                    preguntar por el origen de las personas.
                </p>

                <div class="sections">
                    <table class="vocab-table">
                        <thead>
                            <tr
                                ><th>Thema</th><th>Grammatik</th><th
                                    >Wortschatz</th
                                ></tr
                            >
                        </thead>
                        <tbody>
                            <tr>
                                <td>Richards Wohnung ist…</td>
                                <td>
                                    Possesivartikel (Nominativ/ Akkusativ) <br
                                    />
                                    Genitiv Eigennamen: Paulos Auto.
                                </td>
                                <td>
                                    Wohnung oder Haus beschreiben <br />

                                    Wohnungsantrag ausfüllen
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .page {
            height: calc(100vh - 60px);
            overflow-y: scroll;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 2rem 1rem;
            font-family:
                system-ui,
                -apple-system,
                Segoe UI,
                Roboto,
                sans-serif;
        }

        h1 {
            margin: 0;
            font-size: 1.7rem;
        }

        .subtitle {
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .sections {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        .vocab-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        .vocab-table th {
            text-align: left;
            padding: 0.3rem 0.6rem;
            background: var(--color-table-header);
            color: var(--color-table-header-text);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--color-table-header-border);
        }

        .vocab-table td {
            padding: 0.4rem 0.6rem;
            border-bottom: 1px solid var(--color-table-row-border);
            color: var(--color-text);
        }

        .vocab-table tr:last-child td {
            border-bottom: none;
        }

        .vocab-table tr:hover td {
            background: var(--color-table-row-hover);
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
