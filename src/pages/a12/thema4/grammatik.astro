---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA12 from "@/components/ActivitesListA12.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";

const rows = [
    { prep: "an",       usage: "Tag / Tageszeit",          kasus: "Dativ", example: "am Montag · am Morgen"           },
    { prep: "ab",       usage: "Beginn (ab jetzt)",         kasus: "Dativ", example: "ab dem 1. Januar · ab Montag"   },
    { prep: "bei",      usage: "W\u00e4hrend einer T\u00e4tigkeit",   kasus: "Dativ", example: "beim Essen · beim Lernen"       },
    { prep: "mit",      usage: "Alter / Zeitpunkt",         kasus: "Dativ", example: "mit 20 Jahren · mit der Zeit"   },
    { prep: "seit",     usage: "Beginn bis jetzt (Dauer)", kasus: "Dativ", example: "seit drei Jahren · seit Montag"  },
    { prep: "nach",     usage: "Danach / zeitlich sp\u00e4ter",       kasus: "Dativ", example: "nach dem Unterricht · nach dem Essen" },
    { prep: "in",       usage: "Zeitraum / Zeitspanne",     kasus: "Dativ", example: "in einer Stunde · im Januar"    },
    { prep: "von",      usage: "Anfang eines Zeitraums",    kasus: "Dativ", example: "von Montag bis Freitag"          },
    { prep: "vor",      usage: "Vor / vor … Zeitspanne",    kasus: "Dativ", example: "vor dem Kurs · vor zwei Stunden" },
    { prep: "zwischen", usage: "Zwischen zwei Zeitpunkten", kasus: "Dativ", example: "zwischen 8 und 9 Uhr"           },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA12 open={4} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik</h1>
                <p class="subtitle text-indications">
                    Temporale Pr&auml;positionen + Dativ
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <div class="table-wrapper">
                            <table class="vocab-table temp-table">
                                <thead>
                                    <tr>
                                        <th class="th-prep">Pr&auml;position</th>
                                        <th class="th-use">Verwendung</th>
                                        <th class="th-kasus">Kasus</th>
                                        <th class="th-ex">Beispiel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {rows.map((r, i) => (
                                        <tr class={i % 2 === 0 ? "row-even" : "row-odd"}>
                                            <td class="td-prep">{r.prep}</td>
                                            <td class="td-use">{r.usage}</td>
                                            <td class="td-kasus">Dativ</td>
                                            <td class="td-ex">{r.example}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1rem; }

        .table-wrapper { overflow-x: auto; }

        .th-prep  { width: 90px; }
        .th-use   { width: 30%; }
        .th-kasus { width: 80px; text-align: center; }
        .th-ex    { }

        .td-prep {
            font-weight: 800;
            font-size: 1rem;
            color: #1d4ed8;
            white-space: nowrap;
            border-right: 2px solid var(--color-table-row-border, #e5e7eb);
        }

        .td-use {
            font-size: 0.88rem;
            color: #374151;
        }

        .td-kasus {
            text-align: center;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #166534;
            background: #dcfce7;
        }

        .td-ex {
            font-size: 0.88rem;
            font-style: italic;
            color: #6b7280;
        }

        .row-even { background: #ffffff; }
        .row-odd  { background: #f9fafb; }
        .temp-table tbody tr:hover { background: #eff6ff; }
    </style>
</Layout>