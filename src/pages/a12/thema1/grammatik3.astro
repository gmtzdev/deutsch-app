---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesListA12 from "@/components/ActivitesListA12.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";

const rows = [
    { pronoun: "ich",      haben_pres: "habe",  haben_prat: "hatte",  sein_pres: "bin",  sein_prat: "war"   },
    { pronoun: "du",       haben_pres: "hast",  haben_prat: "hattest",sein_pres: "bist", sein_prat: "warst" },
    { pronoun: "er/sie/es",haben_pres: "hat",   haben_prat: "hatte",  sein_pres: "ist",  sein_prat: "war"   },
    { pronoun: "wir",      haben_pres: "haben", haben_prat: "hatten", sein_pres: "sind", sein_prat: "waren" },
    { pronoun: "ihr",      haben_pres: "habt",  haben_prat: "hattet", sein_pres: "seid", sein_prat: "wart"  },
    { pronoun: "sie/Sie",  haben_pres: "haben", haben_prat: "hatten", sein_pres: "sind", sein_prat: "waren" },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesListA12 open={1} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik</h1>
                <p class="subtitle text-indications">
                    Präsens & Präteritum — <strong>haben</strong> und <strong>sein</strong>
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <div class="table-wrapper">
                            <table class="conj-table">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="th-pronoun">Pronomen</th>
                                        <th colspan="2" class="th-group haben">haben</th>
                                        <th colspan="2" class="th-group sein">sein</th>
                                    </tr>
                                    <tr>
                                        <th class="th-sub haben">Präsens</th>
                                        <th class="th-sub haben">Präteritum</th>
                                        <th class="th-sub sein">Präsens</th>
                                        <th class="th-sub sein">Präteritum</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {rows.map((r, i) => (
                                        <tr class={i % 2 === 0 ? "row-even" : "row-odd"}>
                                            <td class="td-pronoun">{r.pronoun}</td>
                                            <td class="td-haben">{r.haben_pres}</td>
                                            <td class="td-haben td-prat"><strong>{r.haben_prat}</strong></td>
                                            <td class="td-sein">{r.sein_pres}</td>
                                            <td class="td-sein td-prat"><strong>{r.sein_prat}</strong></td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>

                        <p class="writing-prompt text-indications">
                            Schreiben Sie drei Sätze mit <em>sein</em> und drei Sätze
                            mit <em>haben</em> im Präteritum.
                        </p>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections { display: flex; flex-direction: column; gap: 2rem; }
        .section  { display: flex; flex-direction: column; gap: 1rem; }

        .table-wrapper { overflow-x: auto; }

        .conj-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.92rem;
        }

        /* Top-level group headers */
        .th-pronoun {
            padding: 0.55rem 1rem;
            background: var(--color-table-header, #1f2937);
            color: var(--color-table-header-text, #f9fafb);
            text-align: left;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #374151;
            vertical-align: middle;
        }

        .th-group {
            padding: 0.45rem 0.75rem;
            text-align: center;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            border-bottom: 2px solid transparent;
        }

        .th-group.haben {
            background: #eff6ff;
            color: #1e40af;
            border-bottom-color: #93c5fd;
        }

        .th-group.sein {
            background: #f0fdf4;
            color: #166534;
            border-bottom-color: #86efac;
        }

        .th-sub {
            padding: 0.4rem 0.75rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-align: center;
            font-weight: 600;
        }

        .th-sub.haben {
            background: #dbeafe;
            color: #1d4ed8;
            border-bottom: 1px solid #93c5fd;
        }

        .th-sub.sein {
            background: #dcfce7;
            color: #15803d;
            border-bottom: 1px solid #86efac;
        }

        /* Body rows */
        .conj-table tbody tr { transition: background 0.1s; }
        .conj-table tbody tr:hover { background: #f1f5f9; }

        .row-even { background: #ffffff; }
        .row-odd  { background: #f9fafb; }

        .td-pronoun {
            padding: 0.55rem 1rem;
            font-weight: 700;
            color: #374151;
            white-space: nowrap;
            border-right: 2px solid #e5e7eb;
        }

        .td-haben, .td-sein {
            padding: 0.55rem 0.85rem;
            text-align: center;
        }

        .td-haben { color: #1e40af; }
        .td-sein  { color: #166534; }

        .td-prat { font-size: 1rem; }

        /* Writing prompt */
        .writing-prompt {
            margin-top: 0.5rem;
            font-size: 0.9rem;
            border-left: 3px solid #d1d5db;
            padding-left: 0.75rem;
        }
    </style>
</Layout>