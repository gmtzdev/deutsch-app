---
import Header from "@/components/Header.astro";
import Layout from "../layouts/Layout.astro";

// Lucide-style SVG paths (viewBox="0 0 24 24", stroke, fill="none")
const levels = [
	{
		code: "A1.1",
		title: "Principiante absoluto",
		description:
			"Primeras palabras y saludos. Objetos cotidianos y frases básicas.",
		lessons: 12,
		color: "#22c55e",
		// Sprout
		icon: `<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-9"/><path d="M9.5 9.4c1.1.8 1.8 2.1 2.5 3.6 1 2 2 4.6 5 6.4"/><path d="M5 11a5 5 0 0 1 9.5 0"/>`,
	},
	{
		code: "A1.2",
		title: "Principiante",
		description:
			"Números, colores, familia y rutinas diarias en presente simple.",
		lessons: 14,
		color: "#16a34a",
		// BookOpen
		icon: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
	},
	{
		code: "A2.1",
		title: "Básico",
		description:
			"Verbos irregulares, artículos y el pasado simple (Perfekt).",
		lessons: 16,
		color: "#3b82f6",
		// Book
		icon: `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>`,
	},
	{
		code: "A2.2",
		title: "Elemental",
		description: "Casos nominativo/acusativo, compras y vida en la ciudad.",
		lessons: 18,
		color: "#2563eb",
		// Building2
		icon: `<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>`,
	},
	{
		code: "B1.1",
		title: "Intermedio",
		description:
			"Caso dativo, oraciones subordinadas y narración de eventos pasados.",
		lessons: 20,
		color: "#8b5cf6",
		// MessageCircle
		icon: `<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>`,
	},
	{
		code: "B1.2",
		title: "Intermedio avanzado",
		description:
			"Konjunktiv II, declinaciones del adjetivo y expresión de opiniones.",
		lessons: 22,
		color: "#7c3aed",
		// Lightbulb
		icon: `<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>`,
	},
	{
		code: "B2.1",
		title: "Avanzado",
		description:
			"Voz pasiva, preposiciones complejas y textos argumentativos.",
		lessons: 24,
		color: "#f59e0b",
		// Zap
		icon: `<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>`,
	},
	{
		code: "B2.2",
		title: "Avanzado superior",
		description:
			"Estilo indirecto, registro formal y preparación al examen oficial.",
		lessons: 26,
		color: "#d97706",
		// Trophy
		icon: `<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>`,
	},
];
---

<Layout>
	<div class="page bg-background">
		<Header />

		<section class="hero">
			<h1 class="text-title">Elige tu nivel</h1>
			<p>
				Selecciona el nivel que corresponde a tu conocimiento actual de
				alemán y comienza a aprender.
			</p>
		</section>

		<section class="grid-section">
			<div class="levels-grid">
				{
					levels.map((level) => (
						<article
							class="level-card bg-card"
							style={`--accent: ${level.color}`}
						>
							<div class="card-header">
								<svg
									class="level-icon"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									set:html={level.icon}
								/>
								<span class="level-badge">{level.code}</span>
							</div>
							<h2 class="level-title text-subtitle">
								{level.title}
							</h2>
							<p class="level-desc">{level.description}</p>
							<div class="card-footer">
								<span class="lessons-count">
									📚 {level.lessons} lecciones
								</span>
								<a href="/ejercicio" class="start-btn">
									Comenzar →
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>
	</div>
</Layout>

<script>
	const session = localStorage.getItem("session");
	if (!session) {
		window.location.replace("/login");
	} else {
		const greeting = document.querySelector("#user-greeting");
		if (greeting instanceof HTMLSpanElement) {
			greeting.textContent = session;
		}
	}

	const logoutBtn = document.querySelector("#logout-btn");
	if (logoutBtn instanceof HTMLButtonElement) {
		logoutBtn.addEventListener("click", () => {
			localStorage.removeItem("session");
			window.location.href = "/login";
		});
	}
</script>

<style>
	* {
		box-sizing: border-box;
	}

	.page {
		min-height: 100vh;

		font-family:
			system-ui,
			-apple-system,
			Segoe UI,
			Roboto,
			sans-serif;
	}

	.hero {
		text-align: center;
		padding: 3rem 1.5rem 2rem;
	}

	.hero h1 {
		margin: 0 0 0.6rem;
		font-size: 2rem;
		/* color: #111827; */
	}

	.hero p {
		margin: 0 auto;
		max-width: 520px;
		color: #4b5563;
		font-size: 1rem;
		line-height: 1.6;
	}

	.grid-section {
		padding: 0 1.5rem 4rem;
	}

	.levels-grid {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.2rem;
	}

	.level-card {
		border-radius: 14px;
		padding: 1.35rem;
		box-shadow: 0 4px 16px rgb(0 0 0 / 6%);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		border-top: 4px solid var(--accent);
		transition:
			transform 0.18s,
			box-shadow 0.18s;
	}

	.level-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 28px rgb(0 0 0 / 10%);
	}

	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.level-icon {
		width: 2rem;
		height: 2rem;
		color: var(--accent);
		flex-shrink: 0;
	}

	.level-badge {
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		padding: 0.25rem 0.6rem;
		border-radius: 20px;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
	}

	.level-title {
		margin: 0;
		font-size: 1.05rem;
	}

	.level-desc {
		margin: 0;
		font-size: 0.875rem;
		color: #6b7280;
		line-height: 1.5;
		flex: 1;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.4rem;
	}

	.lessons-count {
		font-size: 0.8rem;
		color: #9ca3af;
		font-weight: 500;
	}

	.start-btn {
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.4rem 0.85rem;
		border-radius: 7px;
		background: var(--accent);
		color: #fff;
		text-decoration: none;
		transition: opacity 0.15s;
	}

	.start-btn:hover {
		opacity: 0.85;
	}

	@media (max-width: 500px) {
		.hero h1 {
			font-size: 1.5rem;
		}

		.levels-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
