---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={10} />

        <main class="page bg-background">
            <Card>
                <h1>Lernziel — Thema 10</h1>
                <p class="subtitle text-indications">
                    Al final de esta unidad podrás saludar, presentarte y
                    preguntar por el origen de las personas.
                </p>

                <div class="sections">
                    <!-- Grammatik -->
                    <div class="section">
                        <TagGrammatik />

                        <ul class="obj-list text-text">
                            <li>
                                <span class="dot dot-blue"></span>
                                Temporale Präposition
                                <em>von…bis, ab, seit</em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Es
                                <em></em>
                            </li>
                        </ul>
                    </div>

                    <!-- Wortschatz -->
                    <div class="section">
                        <TagWortschatz />
                        <div class="vocab-grid">
                            <div class="vocab-group">
                                <h4>Wortschatz</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>kalt</td><td>frío</td>
                                        </tr>
                                        <tr>
                                            <td>warm</td><td>caliente</td>
                                        </tr>
                                        <tr>
                                            <td>heiß</td><td>caliente</td>
                                        </tr>
                                        <tr>
                                            <td>der Regen</td><td>la lluvia</td>
                                        </tr>
                                        <tr>
                                            <td>der Frühling</td><td
                                                >la primavera</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>der Sommer</td><td>el verano</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>der Herbst</td><td>el otoño</td>
                                        </tr>
                                        <tr>
                                            <td>der Winter</td><td
                                                >el invierno</td
                                            >
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="vocab-group">
                                <h4>Wortschatz</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>die Sonne</td><td>el sol</td>
                                        </tr>
                                        <tr>
                                            <td>der Mond</td><td>la luna</td>
                                        </tr>
                                        <tr>
                                            <td>der Stern</td><td
                                                >la estrella</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>der Norden</td><td>el norte</td>
                                        </tr>
                                        <tr>
                                            <td>der Süden</td><td>el sur</td>
                                        </tr>
                                        <tr>
                                            <td>der Westen</td><td>el oeste</td>
                                        </tr>
                                        <tr>
                                            <td>der Osten</td><td>el este</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
