---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={8} />

        <main class="page bg-background">
            <Card>
                <h1>Lernziel — Thema 8</h1>
                <p class="subtitle text-indications">
                    Al final de esta unidad podrás saludar, presentarte y
                    preguntar por el origen de las personas.
                </p>

                <div class="sections">
                    <!-- Grammatik -->
                    <div class="section">
                        <TagGrammatik />

                        <ul class="obj-list text-text">
                            <li>
                                <span class="dot dot-blue"></span>
                                Modalverb
                                <em>wollen</em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Lokale Präposition
                                <em>von…bis</em>
                            </li>
                        </ul>
                    </div>

                    <!-- Wortschatz -->
                    <div class="section">
                        <TagWortschatz />
                        <div class="vocab-grid">
                            <div class="vocab-group">
                                <h4>Wortschatz</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>einsteigen </td><td>subir</td>
                                        </tr>
                                        <tr>
                                            <td>umsteigen </td><td
                                                >cambiar de tren / autobús</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>aussteigen </td><td>bajar</td>
                                        </tr>
                                        <tr>
                                            <td>wechseln </td><td>cambiar</td>
                                        </tr>
                                        <tr>
                                            <td>Zwischenstopp</td><td>escala</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>Verkehrsmittel</td><td
                                                >medio de transporte</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>Bus / U-Bahn / Zug</td><td
                                                >autobús / metro / tren</td
                                            >
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="vocab-group">
                                <h4>Wortschatz</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Bahnhof</td><td
                                                >estación de tren</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>warten</td><td>esperar</td>
                                        </tr>
                                        <tr>
                                            <td>Gleis</td><td>andén</td>
                                        </tr>
                                        <tr>
                                            <td>geschlossen</td><td>cerrado</td>
                                        </tr>
                                        <tr>
                                            <td>offen</td><td>abierto</td>
                                        </tr>
                                        <tr>
                                            <td>wollen</td><td>querer</td>
                                        </tr>
                                        <tr>
                                            <td>Fahrschein</td><td>billete</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
