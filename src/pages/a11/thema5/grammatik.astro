---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={5} />

        <main class="page bg-background">
            <Card>
                <h1>Lernziel — Thema 5</h1>
                <p class="subtitle text-indications">
                    Präpositionen <strong>um / am</strong>
                </p>

                <div class="sections">
                    <!-- Grammatik -->
                    <div class="section">
                        <TagGrammatik />

                        <ul class="obj-list text-text">
                            <li>
                                <span class="dot dot-blue"></span>
                                Ich kann um 19 Uhr.
                                <em></em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Ich kann am Montag.
                                <em></em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Wir gehen am 19.07 in den Urlaub.
                            </li>
                        </ul>
                    </div>

                    <div class="section">
                        <p>
                            Der Akkusativ ist der 4. Fall im Deutschen. Du
                            brauchst ihn, wenn du ausdrücken willst, <strong
                                >wen oder was
                            </strong> eine Handlung betrifft. Verben, die man im Akkusativ
                            benutzt, sind: haben / sehen / hören
                        </p>
                    </div>

                    <!-- Wortschatz -->
                    <div class="section">
                        <TagGrammatik />

                        <div class="vocab-group">
                            <h4 class="text-center">
                                <strong>Der Akkusativ</strong>
                            </h4>
                            <p class="text-center">
                                <strong
                                    >Artikel, Possessivartikel, Negation</strong
                                >
                            </p>
                            <table class="vocab-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th colspan="3">Singular</th>
                                        <th rowspan="2" class="text-center"
                                            >Plural <br /> M,N,F</th
                                        >
                                    </tr>

                                    <tr>
                                        <th></th>
                                        <th>M</th>
                                        <th>N</th>
                                        <th>F</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Nominativ</td>
                                        <td>der</td>
                                        <td>das</td>
                                        <td>die</td>
                                        <td>die</td>
                                    </tr>
                                    <tr>
                                        <td>(Wer? Was?)</td>
                                        <td>ein</td>
                                        <td>ein</td>
                                        <td>eine</td>
                                        <td>-</td>
                                    </tr>
                                    <tr>
                                        <td>poss. / Negation</td>
                                        <td>mein / kein</td>
                                        <td>mein / kein</td>
                                        <td>meine / keine</td>
                                        <td>meine / keine</td>
                                    </tr>
                                    <tr>
                                        <td>Akkusativ</td>
                                        <td>den</td>
                                        <td>das</td>
                                        <td>die</td>
                                        <td>die</td>
                                    </tr>
                                    <tr>
                                        <td>(Wen? Was?)</td>
                                        <td>einen</td>
                                        <td>ein</td>
                                        <td>eine</td>
                                        <td>-</td>
                                    </tr>
                                    <tr>
                                        <td>poss. / Negation</td>
                                        <td>meinen / keinen</td>
                                        <td>mein / kein</td>
                                        <td>meine / keine</td>
                                        <td>meine / keine</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
