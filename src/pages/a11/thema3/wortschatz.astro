---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={3} teil={2} />

        <main class="page bg-background">
            <Card>
                <h1>Wortschatz</h1>
                <p class="subtitle text-indications">
                    Zeichne einen Familienstammbaum:
                </p>

                <div class="sections">
                    <!-- Wortschatz -->
                    <div class="section">
                        <TagWortschatz />
                        <div class="vocab-grid">
                            <div class="vocab-group">
                                <h4>Wortschatz</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Oma</td><td>la abuela</td>
                                        </tr>
                                        <tr>
                                            <td>Opa</td><td>el abuelo</td>
                                        </tr>
                                        <tr>
                                            <td>Mutter </td><td>la madre</td>
                                        </tr>
                                        <tr>
                                            <td>Vater</td><td>el padre</td>
                                        </tr>
                                        <tr>
                                            <td>Schwester</td><td>la hermana</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>Bruder</td><td>el hermano</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="vocab-group">
                                <h4>Wortschatz</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Sohn </td><td>el hijo</td>
                                        </tr>
                                        <tr>
                                            <td>Schwester </td><td
                                                >la hermana</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>Sohn </td><td>el hijo</td>
                                        </tr>
                                        <tr>
                                            <td>Tochter </td><td>la hija</td>
                                        </tr>
                                        <tr>
                                            <td>Enkel </td><td>el nieto</td>
                                        </tr>
                                        <tr>
                                            <td>Enkelin </td><td>la nieta</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
