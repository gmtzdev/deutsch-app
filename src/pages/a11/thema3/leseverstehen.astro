---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
import "@/styles/quiz.css";
const exercises = [
    {
        id: 1,
        before: "Wie heisst die Oma?",
        answer: "Die Oma heißt Olga.",
        after: "",
    },
    {
        id: 2,
        before: "Wie viele Schwestern hat Leo?",
        answer: "Leo hat zwei Schwestern.",
        after: "",
    },
    {
        id: 3,
        before: "Wie alt ist der große Bruder Fabian?​",
        answer: "Fabian ist 12 Jahre alt.",
        after: "",
    },
    {
        id: 4,
        before: "Wie alt ist die große Schwester Eva?",
        answer: "Eva ist 15 Jahre alt.",
        after: "",
    },
    {
        id: 5,
        before: "Wie alt ist der kleine Bruder Tom?",
        answer: "Tom ist 6 Jahre alt.",
        after: "",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={3} />

        <main class="page bg-background">
            <Card>
                <h1>Leseverstehen</h1>
                <p class="subtitle text-indications">
                    Lesen Sie und beantworten Sie die Fragen.
                </p>

                <div class="sections">
                    <!-- Leseverstehen -->
                    <div class="section">
                        <p class="text-block text-text">
                            Hallo!​ Ich heiße Leo. Ich bin 12 Jahre alt. Das ist
                            meine Familie.​ Meine Oma heißt Olga. Sie ist 69
                            Jahre alt. Mein Opa heißt Peter. Er ist 70.​ Meine
                            Mama ist Helga. Sie ist 40 Jahre alt. Mein Papa ist
                            Mario. Er ist 40.​ Ich habe zwei Geschwister: zwei
                            Schwestern und zwei Brüdern.​ Meine große Schwester
                            heißt Eva. Sie ist 15 Jahre alt.​ Meine kleine
                            Schwester heißt Sonia. Sie ist 10.​ Mein kleiner
                            Bruder Tom ist 6 Jahre alt und mein großer Bruder
                            heißt Fabian und ist 12 Jahre alt. ​ Wir wohnen alle
                            zusammen in einem Haus.
                        </p>
                    </div>

                    <!-- Ejercicio -->
                    <div class="section">
                        <form id="quiz-form" class="quiz" autocomplete="off">
                            <p class="subtitle">
                                Escribe la palabra que falta en cada oración y
                                luego pulsa "Corregir".
                            </p>
                            {
                                exercises.map((exercise) => (
                                    <label
                                        class="row"
                                        data-answer={exercise.answer}
                                    >
                                        <span class="sentence">
                                            {exercise.before} ___{" "}
                                            {exercise.after}
                                        </span>
                                        <input
                                            type="text"
                                            name={`exercise-${exercise.id}`}
                                            placeholder="Tu respuesta"
                                            required
                                        />
                                        <span
                                            class="feedback"
                                            aria-live="polite"
                                        />
                                    </label>
                                ))
                            }

                            <div class="actions">
                                <button class="button-submit" type="submit"
                                    >Corregir</button
                                >
                            </div>
                        </form>

                        <p id="result" class="result" aria-live="polite"></p>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <script>
        if (!localStorage.getItem("session")) {
            window.location.replace("/login");
        }

        const form = document.querySelector("#quiz-form");
        const result = document.querySelector("#result");

        if (
            form instanceof HTMLFormElement &&
            result instanceof HTMLParagraphElement
        ) {
            form.addEventListener("submit", (event) => {
                event.preventDefault();

                const rows = [...form.querySelectorAll(".row")];
                let score = 0;

                rows.forEach((row) => {
                    if (!(row instanceof HTMLLabelElement)) return;

                    const input = row.querySelector("input");
                    const feedback = row.querySelector(".feedback");
                    const expected = row.dataset.answer ?? "";

                    if (
                        !(input instanceof HTMLInputElement) ||
                        !(feedback instanceof HTMLSpanElement)
                    )
                        return;

                    const userAnswer = input.value.trim().toLocaleLowerCase();
                    const correctAnswer = expected.trim().toLocaleLowerCase();

                    if (userAnswer === correctAnswer) {
                        score += 1;
                        row.classList.remove("wrong");
                        row.classList.add("correct");
                        feedback.textContent = "✅ Correcto";
                    } else {
                        row.classList.remove("correct");
                        row.classList.add("wrong");
                        feedback.textContent = `❌ Correcta: ${expected}`;
                    }
                });

                result.textContent = `Tu puntuación final es ${score} de ${rows.length} aciertos.`;
            });
        }
    </script>
</Layout>
