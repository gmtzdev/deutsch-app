---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
import "@/styles/quiz.css";

const exercises = [
    {
        id: 1,
        before: "Wie",
        answer: "ist",
        after: "es dir? Das ist Sabrina..",
    },
    {
        id: 2,
        before: "Sie",
        answer: "ist",
        after: "meine Freundin. Kennst du sie?",
    },
    {
        id: 3,
        before: "Nein, ich",
        answer: "weiß",
        after: "sie nicht. Hallo Sabrina, ich heiße Anna.",
    },
    {
        id: 4,
        before: "Hallo Anna! wollen wir zusammen einen Kaffee",
        answer: "trinken",
        after: "?",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={3} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatikübung</h1>
                <p class="subtitle text-indications">
                    Füllen Sie diesen Text aus:
                </p>

                <div class="sections">
                    <div class="section">
                        <img
                            style="width: 350px; margin: 0 auto;"
                            src="/a11/thema3/sprechen.png"
                            alt=""
                        />
                    </div>
                    <!-- Grammatik -->
                    <div class="section">
                        <form id="quiz-form" class="quiz" autocomplete="off">
                            <p class="subtitle">
                                Escribe la palabra que falta en cada oración y
                                luego pulsa "Corregir".
                            </p>
                            {
                                exercises.map((exercise) => (
                                    <label
                                        class="row"
                                        data-answer={exercise.answer}
                                    >
                                        <span class="sentence">
                                            {exercise.before} ___{" "}
                                            {exercise.after}
                                        </span>
                                        <input
                                            type="text"
                                            name={`exercise-${exercise.id}`}
                                            placeholder="Tu respuesta"
                                            required
                                        />
                                        <span
                                            class="feedback"
                                            aria-live="polite"
                                        />
                                    </label>
                                ))
                            }

                            <div class="actions">
                                <button class="button-submit" type="submit"
                                    >Corregir</button
                                >
                            </div>
                        </form>

                        <p id="result" class="result" aria-live="polite"></p>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
