---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import "@/styles/page.css";
import "@/styles/quiz.css";

const exercises = [
    {
        id: 1,
        before: "Das ist",
        answer: "meine",
        after: "Familie.",
    },
    {
        id: 2,
        before: "Meine Oma",
        answer: "heißt",
        after: "Olga. Sie ist 69 Jahre alt.",
    },
    {
        id: 3,
        before: "Meine Oma heißt Olga. Sie",
        answer: "ist",
        after: "69 Jahre alt.",
    },
    {
        id: 4,
        before: "Meine große Schwester heißt Eva.",
        answer: "Sie",
        after: "ist 15 Jahre alt.",
    },
    {
        id: 5,
        before: "Mein kleiner Bruder Tom",
        answer: "ist",
        after: "6 Jahre alt.",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={3} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatikübung 2</h1>
                <p class="subtitle text-indications">
                    Füllen Sie die Lücken im Text aus:
                </p>

                <div class="sections">
                    <!-- Lese den Text -->
                    <div class="section">
                        <p class="text-block text-text">
                            Hallo! Ich heiße Leo. Ich bin 12 Jahre alt. Das ist
                            <strong>_____</strong> Familie. Meine Oma
                            <strong>_____</strong> Olga. Sie
                            <strong>___</strong> 69 Jahre alt. Mein Opa heißt Peter.
                            Er ist 70. Meine Mama ist Helga. Sie ist 40 Jahre alt.
                            Mein Papa ist Mario. Er ist 40. Ich habe zwei Geschwister:
                            zwei Schwestern und zwei Brüder. Meine große Schwester
                            heißt Eva.
                            <strong>___</strong> ist 15 Jahre alt. Meine kleine Schwester
                            heißt Sonia. Sie ist 10. Mein kleiner Bruder Tom <strong
                                >_____</strong
                            > 6 Jahre alt und mein großer Bruder heißt Fabian und
                            ist 12 Jahre alt. Wir wohnen alle zusammen in einem Haus.
                        </p>
                    </div>

                    <!-- Ejercicio -->
                    <div class="section">
                        <form id="quiz-form" class="quiz" autocomplete="off">
                            <p class="subtitle">
                                Escribe la palabra que falta en cada oración y
                                luego pulsa "Corregir".
                            </p>
                            {
                                exercises.map((exercise) => (
                                    <label
                                        class="row"
                                        data-answer={exercise.answer}
                                    >
                                        <span class="sentence">
                                            {exercise.before} ___{" "}
                                            {exercise.after}
                                        </span>
                                        <input
                                            type="text"
                                            name={`exercise-${exercise.id}`}
                                            placeholder="Tu respuesta"
                                            required
                                        />
                                        <span
                                            class="feedback"
                                            aria-live="polite"
                                        />
                                    </label>
                                ))
                            }

                            <div class="actions">
                                <button class="button-submit" type="submit"
                                    >Corregir</button
                                >
                            </div>
                        </form>

                        <p id="result" class="result" aria-live="polite"></p>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <script>
        if (!localStorage.getItem("session")) {
            window.location.replace("/login");
        }

        const form = document.querySelector("#quiz-form");
        const result = document.querySelector("#result");

        if (
            form instanceof HTMLFormElement &&
            result instanceof HTMLParagraphElement
        ) {
            form.addEventListener("submit", (event) => {
                event.preventDefault();

                const rows = [...form.querySelectorAll(".row")];
                let score = 0;

                rows.forEach((row) => {
                    if (!(row instanceof HTMLLabelElement)) return;

                    const input = row.querySelector("input");
                    const feedback = row.querySelector(".feedback");
                    const expected = row.dataset.answer ?? "";

                    if (
                        !(input instanceof HTMLInputElement) ||
                        !(feedback instanceof HTMLSpanElement)
                    )
                        return;

                    const userAnswer = input.value.trim().toLocaleLowerCase();
                    const correctAnswer = expected.trim().toLocaleLowerCase();

                    if (userAnswer === correctAnswer) {
                        score += 1;
                        row.classList.remove("wrong");
                        row.classList.add("correct");
                        feedback.textContent = "✅ Correcto";
                    } else {
                        row.classList.remove("correct");
                        row.classList.add("wrong");
                        feedback.textContent = `❌ Correcta: ${expected}`;
                    }
                });

                result.textContent = `Tu puntuación final es ${score} de ${rows.length} aciertos.`;
            });
        }
    </script>
</Layout>
