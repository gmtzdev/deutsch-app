---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={2} />

        <main class="page bg-background">
            <Card>
                <h1>Lernziel — Thema 2</h1>
                <p class="subtitle text-indications">
                    Al final de esta unidad podrás saludar, presentarte y
                    preguntar por el origen de las personas.
                </p>

                <div class="sections">
                    <!-- Grammatik -->
                    <div class="section">
                        <TagGrammatik />

                        <ul class="obj-list text-text">
                            <li>
                                <span class="dot dot-blue"></span>
                                Possesivartikel
                                <em></em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Negation
                                <em></em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Wortbildung -in feminin
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Verb: machen / arbeiten / haben / leben​
                            </li>
                        </ul>
                    </div>

                    <!-- Wortschatz -->
                    <div class="section">
                        <TagWortschatz />
                        <div class="vocab-grid">
                            <div class="vocab-group">
                                <h4>Nummer / Verben</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>0-20</td><td>0-20</td>
                                        </tr>
                                        <tr>
                                            <td>Arbeiten</td><td>Trabajar</td>
                                        </tr>
                                        <tr>
                                            <td>Machen</td><td>Hacer</td>
                                        </tr>
                                        <tr>
                                            <td>Beruf</td><td>Profesión</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="vocab-group">
                                <h4>Verben</h4>
                                <table class="vocab-table">
                                    <thead>
                                        <tr><th>Deutsch</th><th>Español</th></tr
                                        >
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Ich arbeite als/bei​</td><td
                                                >Trabajo como/en</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>Familie</td><td>Familia</td>
                                        </tr>
                                        <tr>
                                            <td>Familienstand</td><td
                                                >Estado civil</td
                                            >
                                        </tr>
                                        <tr>
                                            <td>Mir geht es nicht gut​</td><td
                                                >No me siento bien</td
                                            >
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
