---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";

const exercises = [
    {
        id: 1,
        before: "",
        blank: "Mein",
        after: "Bruder ist 14 Jahre alt.",
        hint: "Possessivartikel (ich + Maskulinum)",
    },
    {
        id: 2,
        before: "Meine Schwester ist Lehrer",
        blank: "in",
        after: "von Beruf.",
        hint: "Wortbildung Femininum (-in)",
    },
    {
        id: 3,
        before: "Ich habe kei",
        blank: "ne",
        after: "Kinder.",
        hint: "Negation mit kein/keine (Plural)",
    },
    {
        id: 4,
        before: "",
        blank: "Meine",
        after: "Familie lebt in der Türkei.",
        hint: "Possessivartikel (ich + Femininum)",
    },
    {
        id: 5,
        before: "",
        blank: "Mir",
        after: "geht es heute sehr gut.",
        hint: "Personalpronomen Dativ",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={2} />

        <main class="page bg-background">
            <Card>
                <TagGrammatik />
                <h1>Grammatikübung</h1>
                <p class="subtitle text-indications">
                    Completa las oraciones con la forma correcta del artículo
                    posesivo, la negación o el pronombre.
                </p>

                <form id="quiz-form" class="quiz" autocomplete="off">
                    {
                        exercises.map((ex) => (
                            <div class="row" data-answer={ex.blank}>
                                <span class="sentence">
                                    {ex.before}
                                    <span class="gap">___</span>
                                    {ex.after}
                                </span>
                                <span class="hint">{ex.hint}</span>
                                <div class="input-wrap">
                                    <input
                                        type="text"
                                        name={`ex-${ex.id}`}
                                        placeholder="Respuesta"
                                        autocomplete="off"
                                        spellcheck={false}
                                    />
                                    <span class="feedback" aria-live="polite" />
                                </div>
                            </div>
                        ))
                    }
                    <div class="actions">
                        <button type="submit">Corregir</button>
                        <button type="reset" class="btn-reset">Reiniciar</button
                        >
                    </div>
                </form>

                <p id="result" class="result" aria-live="polite"></p>
            </Card>
        </main>
    </div>

    <script>
        const form = document.querySelector("#quiz-form");
        const result = document.querySelector("#result");

        if (
            form instanceof HTMLFormElement &&
            result instanceof HTMLParagraphElement
        ) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                const rows = [...form.querySelectorAll(".row")];
                let score = 0;

                rows.forEach((row) => {
                    if (!(row instanceof HTMLElement)) return;
                    const input = row.querySelector("input");
                    const feedback = row.querySelector(".feedback");
                    const expected = row.dataset.answer ?? "";

                    if (
                        !(input instanceof HTMLInputElement) ||
                        !(feedback instanceof HTMLSpanElement)
                    )
                        return;

                    const userVal = input.value.trim().toLowerCase();
                    const correctVal = expected.trim().toLowerCase();

                    if (userVal === correctVal) {
                        score++;
                        row.classList.remove("wrong");
                        row.classList.add("correct");
                        feedback.textContent = "✅ Correcto";
                    } else {
                        row.classList.remove("correct");
                        row.classList.add("wrong");
                        feedback.textContent = `❌ ${expected}`;
                    }
                });

                result.textContent = `Puntuación: ${score} / ${rows.length}`;
            });

            form.addEventListener("reset", () => {
                form.querySelectorAll(".row").forEach((row) => {
                    row.classList.remove("correct", "wrong");
                    const fb = row.querySelector(".feedback");
                    if (fb instanceof HTMLSpanElement) fb.textContent = "";
                });
                result.textContent = "";
            });
        }
    </script>

    <style>
        .quiz {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr auto;
            grid-template-rows: auto auto;
            gap: 0.4rem 1rem;
            padding: 0.75rem 1rem;
            border: 1px solid var(--color-table-row-border);
            border-radius: 10px;
            align-items: center;
        }

        .sentence {
            font-size: 0.97rem;
            font-weight: 500;
            color: var(--color-text);
            grid-column: 1;
            grid-row: 1;
        }

        .gap {
            color: #9ca3af;
            letter-spacing: 0.05em;
        }

        .hint {
            font-size: 0.72rem;
            color: #9ca3af;
            grid-column: 1;
            grid-row: 2;
        }

        .input-wrap {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            grid-column: 2;
            grid-row: 1 / 3;
        }

        input {
            padding: 0.5rem 0.65rem;
            border: 1px solid var(--color-table-row-border);
            border-radius: 8px;
            font-size: 0.95rem;
            width: 130px;
            color: var(--color-text);
            background: var(--color-background, #fff);
        }

        .feedback {
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 0.5rem;
        }

        button {
            padding: 0.65rem 1.2rem;
            font-size: 0.95rem;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        button[type="submit"] {
            background: #111827;
            color: #fff;
        }

        .btn-reset {
            background: transparent;
            border: 1px solid var(--color-table-row-border);
            color: var(--color-text);
        }

        .result {
            margin-top: 0.75rem;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--color-text);
        }

        .row.correct {
            border-color: #10b981;
            background: #ecfdf5;
        }

        .row.wrong {
            border-color: #ef4444;
            background: #fef2f2;
        }

        @media (max-width: 600px) {
            .row {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto auto;
            }

            .input-wrap {
                grid-column: 1;
                grid-row: 3;
            }

            input {
                width: 100%;
            }
        }
    </style>
</Layout>
