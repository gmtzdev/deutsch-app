---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";

const estados = [
    {
        emoji: "🧍",
        deutsch: "ledig",
        espanol: "soltero/a",
        beispiel: "Ich bin ledig.",
    },
    {
        emoji: "💍",
        deutsch: "verlobt sein",
        espanol: "estar comprometido/a",
        beispiel: "Wir sind verlobt.",
    },
    {
        emoji: "💑",
        deutsch: "verheiratet sein",
        espanol: "estar casado/a",
        beispiel: "Sie ist verheiratet.",
    },
    {
        emoji: "💔",
        deutsch: "geschieden sein",
        espanol: "estar divorciado/a",
        beispiel: "Er ist geschieden.",
    },
    {
        emoji: "🕊️",
        deutsch: "verwitwet sein",
        espanol: "ser viudo/a",
        beispiel: "Sie ist Witwe.",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={2} teil={5} />

        <main class="page bg-background">
            <Card>
                <h1>Familienstand</h1>
                <p class="subtitle text-indications">
                    Vocabulario para describir el estado civil en alemán.
                </p>

                <div class="sections">
                    <div class="section">
                        <TagWortschatz />

                        <div class="cards-grid">
                            {
                                estados.map((e) => (
                                    <div class="status-card">
                                        <span class="status-emoji">
                                            {e.emoji}
                                        </span>
                                        <div class="status-info">
                                            <strong class="status-de">
                                                {e.deutsch}
                                            </strong>
                                            <span class="status-es">
                                                {e.espanol}
                                            </span>
                                            <em class="status-ex">
                                                {e.beispiel}
                                            </em>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>

                        <div class="table-wrapper">
                            <table class="vocab-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Deutsch</th>
                                        <th>Español</th>
                                        <th>Beispiel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {
                                        estados.map((e) => (
                                            <tr>
                                                <td class="td-emoji">
                                                    {e.emoji}
                                                </td>
                                                <td>
                                                    <strong>{e.deutsch}</strong>
                                                </td>
                                                <td>{e.espanol}</td>
                                                <td class="td-example">
                                                    <em>{e.beispiel}</em>
                                                </td>
                                            </tr>
                                        ))
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .page {
            min-height: calc(100vh - 60px);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 2rem 1rem;
            font-family:
                system-ui,
                -apple-system,
                Segoe UI,
                Roboto,
                sans-serif;
        }

        h1 {
            margin: 0;
            font-size: 1.7rem;
        }

        .subtitle {
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .sections {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .section {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        /* Cards */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 0.75rem;
        }

        .status-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            padding: 1rem 0.75rem;
            border: 1px solid var(--color-table-row-border);
            border-radius: 12px;
            text-align: center;
        }

        .status-emoji {
            font-size: 2.4rem;
            line-height: 1;
        }

        .status-info {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }

        .status-de {
            font-size: 0.92rem;
            color: var(--color-text);
        }

        .status-es {
            font-size: 0.78rem;
            color: #6b7280;
        }

        .status-ex {
            font-size: 0.72rem;
            color: #9ca3af;
        }

        /* Table */
        .table-wrapper {
            overflow-x: auto;
        }

        .vocab-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        .vocab-table th {
            text-align: left;
            padding: 0.4rem 0.75rem;
            background: var(--color-table-header);
            color: var(--color-table-header-text);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--color-table-header-border);
        }

        .vocab-table td {
            padding: 0.45rem 0.75rem;
            border-bottom: 1px solid var(--color-table-row-border);
            color: var(--color-text);
        }

        .vocab-table tr:last-child td {
            border-bottom: none;
        }

        .vocab-table tr:hover td {
            background: var(--color-table-row-hover);
        }

        .td-emoji {
            font-size: 1.3rem;
            text-align: center;
            width: 2.5rem;
        }

        .td-example {
            color: #6b7280;
            font-size: 0.85rem;
        }
    </style>
</Layout>
