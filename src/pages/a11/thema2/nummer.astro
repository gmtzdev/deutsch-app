---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={2} />

        <main class="page bg-background">
            <Card>
                <h1>Zahlen 0 - 20</h1>
                <p class="subtitle text-indications">
                    Haz clic en un número para ver su nombre en alemán y
                    escuchar su pronunciación.
                </p>

                <div class="sections">
                    <div class="section">
                        <TagWortschatz />

                        <div class="num-grid" id="num-grid">
                            <!-- filled by script -->
                        </div>

                        <div class="detail-card" id="detail-card" hidden>
                            <div class="detail-digit" id="detail-digit"></div>
                            <div class="detail-info">
                                <div class="detail-word" id="detail-word"></div>
                                <div class="detail-trans" id="detail-trans">
                                </div>
                                <button
                                    class="play-btn"
                                    id="play-btn"
                                    aria-label="Escuchar pronunciación"
                                >
                                    ▶ Escuchar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <script>
        if (!localStorage.getItem("session")) {
            window.location.replace("/login");
        }

        type NumberData = {
            digit: number;
            word: string;
            translation: string;
        };

        const numbers: NumberData[] = [
            { digit: 0, word: "null", translation: "cero" },
            { digit: 1, word: "eins", translation: "uno" },
            { digit: 2, word: "zwei", translation: "dos" },
            { digit: 3, word: "drei", translation: "tres" },
            { digit: 4, word: "vier", translation: "cuatro" },
            { digit: 5, word: "fÃ¼nf", translation: "cinco" },
            { digit: 6, word: "sechs", translation: "seis" },
            { digit: 7, word: "sieben", translation: "siete" },
            { digit: 8, word: "acht", translation: "ocho" },
            { digit: 9, word: "neun", translation: "nueve" },
            { digit: 10, word: "zehn", translation: "diez" },
            { digit: 11, word: "elf", translation: "once" },
            { digit: 12, word: "zwÃ¶lf", translation: "doce" },
            { digit: 13, word: "dreizehn", translation: "trece" },
            { digit: 14, word: "vierzehn", translation: "catorce" },
            { digit: 15, word: "fÃ¼nfzehn", translation: "quince" },
            { digit: 16, word: "sechzehn", translation: "diecisÃ©is" },
            { digit: 17, word: "siebzehn", translation: "diecisiete" },
            { digit: 18, word: "achtzehn", translation: "dieciocho" },
            { digit: 19, word: "neunzehn", translation: "diecinueve" },
            { digit: 20, word: "zwanzig", translation: "veinte" },
        ];

        const grid = document.getElementById("num-grid")!;
        const detailCard = document.getElementById(
            "detail-card",
        ) as HTMLElement;
        const detailDigit = document.getElementById("detail-digit")!;
        const detailWord = document.getElementById("detail-word")!;
        const detailTrans = document.getElementById("detail-trans")!;
        const playBtn = document.getElementById(
            "play-btn",
        ) as HTMLButtonElement;

        let activeBtn: HTMLButtonElement | null = null;
        let activeWord = "";

        numbers.forEach((item) => {
            const btn = document.createElement("button");
            btn.className = "num-btn";
            btn.innerHTML = `<span class="btn-digit">${item.digit}</span><span class="btn-word">${item.word}</span>`;
            btn.addEventListener("click", () => {
                activeBtn?.classList.remove("active");
                btn.classList.add("active");
                activeBtn = btn;
                activeWord = item.word;

                detailDigit.textContent = String(item.digit);
                detailWord.textContent = item.word;
                detailTrans.textContent = item.translation;
                detailCard.hidden = false;
            });
            grid.appendChild(btn);
        });

        playBtn.addEventListener("click", () => {
            if (!activeWord) return;
            const utterance = new SpeechSynthesisUtterance(activeWord);
            utterance.lang = "de-DE";
            utterance.rate = 0.8;
            window.speechSynthesis.speak(utterance);
        });
    </script>

    <style>
        .sections {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .section {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .num-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            gap: 0.5rem;
            margin-top: 0.75rem;
        }

        .num-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.15rem;
            padding: 0.6rem 0.4rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            background: #fff;
            color: #1f2937;
            cursor: pointer;
            transition: all 0.15s;
        }

        .num-btn:hover {
            border-color: #6366f1;
            color: #4f46e5;
            background: #eef2ff;
        }

        .num-btn.active {
            background: #4f46e5;
            color: #fff;
            border-color: #4f46e5;
            box-shadow: 0 2px 8px rgba(79, 70, 229, 0.35);
        }

        .btn-digit {
            font-size: 1.3rem;
            font-weight: 800;
            line-height: 1;
        }

        .btn-word {
            font-size: 0.7rem;
            font-weight: 500;
            opacity: 0.8;
        }

        .num-btn.active .btn-word {
            opacity: 1;
        }

        .detail-card {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-top: 1rem;
            padding: 1.25rem 1.5rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
        }

        .detail-digit {
            font-size: 4rem;
            font-weight: 800;
            color: #4f46e5;
            line-height: 1;
            min-width: 60px;
            text-align: center;
        }

        .detail-info {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .detail-word {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1f2937;
        }

        .detail-trans {
            font-size: 0.9rem;
            color: #6b7280;
        }

        .play-btn {
            margin-top: 0.5rem;
            padding: 0.35rem 0.9rem;
            font-size: 0.85rem;
            font-weight: 600;
            border: 1.5px solid #6366f1;
            border-radius: 999px;
            background: #fff;
            color: #4f46e5;
            cursor: pointer;
            width: fit-content;
            transition: all 0.15s;
        }

        .play-btn:hover {
            background: #4f46e5;
            color: #fff;
        }
    </style>
</Layout>
