---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/tables.css";
import "@/styles/page.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={1} teil={2} />

        <main class="page bg-background">
            <Card>
                <h1>Personalpronomen Singular</h1>
                <p class="subtitle">
                    Los pronombres personales indican quién realiza la acción.
                    En alemán, el género gramatical determina el pronombre de
                    3.ª persona.
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />

                        <table class="vocab-table">
                            <thead>
                                <tr>
                                    <th colspan="6">Singular</th>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th>1. Person</th>
                                    <th>2. Person</th>
                                    <th colspan="3">3. Person</th>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th>Maskulin</th>
                                    <th>Feminin</th>
                                    <th>Neutrum</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="label">Nominativ</td>
                                    <td><strong>ich</strong></td>
                                    <td><strong>du</strong></td>
                                    <td><strong>er</strong></td>
                                    <td><strong>sie</strong></td>
                                    <td><strong>es</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <script>
        if (!localStorage.getItem("session")) {
            window.location.replace("/login");
        }
    </script>

    <style>
        .sections {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }
    </style>
</Layout>
