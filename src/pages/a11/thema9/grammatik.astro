---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={9} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik</h1>
                <p class="subtitle text-indications">
                    El verbo siempre va en segunda posición en la oración. La
                    mayoria de los paticipios empiezan con "ge-" y terminan con
                    "-t" o "-en".
                </p>

                <div class="sections">
                    <!-- Grammatik -->
                    <div class="section">
                        <TagGrammatik />
                        <p>Beispiel in anderen Sprachen:</p>
                        <ul class="obj-list text-text">
                            <li>
                                <span class="dot dot-blue"></span>
                                Deutsch:
                                <em> Sofie hat ihre Arbeit beendet. </em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Englisch:
                                <em> Sophie has finished her work. </em>
                            </li>
                            <li>
                                <span class="dot dot-blue"></span>
                                Spanisch:
                                <em> Sofía ha terminado su trabajo. </em>
                            </li>
                        </ul>
                    </div>

                    <!-- Wortschatz -->
                    <div class="section">
                        <h2 class="text-center font-bold">
                            haben / sein + Partizip II
                        </h2>

                        <p class="text-center text-xl">
                            Sofie <strong class="text-red-400">hat</strong> ihre Arbeit
                            <strong class="text-red-400">beendet</strong>.
                        </p>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
