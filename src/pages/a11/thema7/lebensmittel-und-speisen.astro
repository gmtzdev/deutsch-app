---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={7} />

        <main class="page bg-background">
            <Card>
                <h1>Lernziel — Thema 7</h1>
                <p class="subtitle text-indications">
                    Al final de esta unidad podrás saludar, presentarte y
                    preguntar por el origen de las personas.
                </p>

                <div class="sections">
                    <!-- Wortschatz -->
                    <div class="section">
                        <TagWortschatz />
                        <div class="vocab-grid">
                            <div class="vocab-group">
                                <p class="text-center">
                                    Nenne 10 Lebensmittel.
                                </p>
                                <img
                                    style="width: 350px; margin: 0 auto;"
                                    src="/a11/thema7/Besteck.png"
                                    alt=""
                                />
                            </div>
                            <div class="vocab-group">
                                <p class="text-center">
                                    Nenne 10 deutsche Speisen.
                                </p>
                                <img
                                    style="width: 350px; margin: 0 auto;"
                                    src="/a11/thema7/Besteck.png"
                                    alt=""
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
