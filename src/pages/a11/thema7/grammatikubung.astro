---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
import "@/styles/quiz.css";

const exercises = [
    {
        id: 1,
        question: "Hast du Zeit?",
        reply: "_____, ich habe Zeit.",
        answer: "Ja",
        hint: "Pregunta positiva → respuesta positiva",
    },
    {
        id: 2,
        question: "Hast du Zeit?",
        reply: "_____, ich habe keine Zeit.",
        answer: "Nein",
        hint: "Pregunta positiva → respuesta negativa",
    },
    {
        id: 3,
        question: "Hast du keine Zeit?",
        reply: "_____, ich habe Zeit.",
        answer: "Doch",
        hint: "Pregunta negativa → respuesta positiva = Doch",
    },
    {
        id: 4,
        question: "Hast du keine Zeit?",
        reply: "_____, ich habe keine Zeit.",
        answer: "Nein",
        hint: "Pregunta negativa → respuesta negativa = Nein",
    },
    {
        id: 5,
        question: "Kannst du mir helfen?",
        reply: "_____, ich kann dir helfen.",
        answer: "Ja",
        hint: "Pregunta positiva → respuesta positiva",
    },
    {
        id: 6,
        question: "Kannst du mir nicht helfen?",
        reply: "_____, ich kann dir helfen.",
        answer: "Doch",
        hint: "Pregunta negativa (nicht) → respuesta positiva = Doch",
    },
    {
        id: 7,
        question: "Magst du kein Fleisch?",
        reply: "_____, ich esse kein Fleisch.",
        answer: "Nein",
        hint: "Pregunta negativa → respuesta negativa = Nein",
    },
    {
        id: 8,
        question: "Magst du kein Fleisch?",
        reply: "_____, ich esse Fleisch.",
        answer: "Doch",
        hint: "Pregunta negativa → respuesta positiva = Doch",
    },
    {
        id: 9,
        question: "Trinkst du keinen Kaffee?",
        reply: "_____, ich trinke Kaffee.",
        answer: "Doch",
        hint: "Pregunta negativa (keinen) → respuesta positiva = Doch",
    },
    {
        id: 10,
        question: "Sprichst du Deutsch?",
        reply: "_____, ich spreche kein Deutsch.",
        answer: "Nein",
        hint: "Pregunta positiva → respuesta negativa",
    },
];
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={7} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatikübung</h1>
                <p class="subtitle text-indications">
                    Ja/Nein-Fragen und Antworten: <strong>Ja</strong>,
                    <strong>Nein</strong>, <strong>Doch</strong>
                </p>

                <div class="sections">

                    <!-- Rule explanation -->
                    <div class="section">
                        <TagGrammatik />
                        <table class="vocab-table rule-table">
                            <thead>
                                <tr>
                                    <th>Frage</th>
                                    <th>Antwort positiv</th>
                                    <th>Antwort negativ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span class="badge badge-pos">+ positiv</span><br />
                                        <em>Hast du Zeit?</em>
                                    </td>
                                    <td>
                                        <span class="kw kw-ja">Ja</span>, ich habe Zeit.
                                    </td>
                                    <td>
                                        <span class="kw kw-nein">Nein</span>, ich habe keine Zeit.
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="badge badge-neg">− negativ</span><br />
                                        <em>Hast du keine Zeit?</em>
                                    </td>
                                    <td>
                                        <span class="kw kw-doch">Doch</span>, ich habe Zeit.
                                    </td>
                                    <td>
                                        <span class="kw kw-nein">Nein</span>, ich habe keine Zeit.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="rule-note text-indications">
                            ⚠️ <strong>Doch</strong> se usa <em>solo</em> para contradecir una
                            pregunta negativa con una respuesta positiva.
                        </p>
                    </div>

                    <!-- Quiz -->
                    <div class="section">
                        <h3 class="quiz-title">Übung: Ja, Nein oder Doch?</h3>
                        <p class="subtitle text-indications">
                            Elige la respuesta correcta para cada oración.
                        </p>

                        <div class="ex-list" id="ex-list">
                            {exercises.map((ex) => (
                                <div class="ex-row" id={`ex-${ex.id}`} data-answer={ex.answer}>
                                    <p class="ex-q">
                                        <span class="ex-num">{ex.id}.</span>
                                        <span class="ex-question">— {ex.question}</span>
                                    </p>
                                    <p class="ex-reply">{ex.reply}</p>
                                    <div class="ex-options">
                                        {["Ja", "Nein", "Doch"].map((opt) => (
                                            <button
                                                type="button"
                                                class="opt-btn"
                                                data-opt={opt}
                                            >
                                                {opt}
                                            </button>
                                        ))}
                                    </div>
                                    <p class="ex-feedback" aria-live="polite"></p>
                                    <p class="ex-hint text-indications">{ex.hint}</p>
                                </div>
                            ))}
                        </div>

                        <div class="actions">
                            <button id="reset-btn" type="button" class="button-reset">
                                Reiniciar
                            </button>
                        </div>
                        <p id="result" class="result" aria-live="polite"></p>
                    </div>

                </div>
            </Card>
        </main>
    </div>

    <style>
        .sections {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        /* Rule table extras */
        .rule-table td { vertical-align: top; }

        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 12px;
            font-size: 0.72rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .badge-pos { background: #dcfce7; color: #166534; }
        .badge-neg { background: #fee2e2; color: #991b1b; }

        .kw {
            display: inline-block;
            font-weight: 800;
            font-size: 1rem;
            padding: 0.1rem 0.4rem;
            border-radius: 6px;
        }

        .kw-ja   { background: #dcfce7; color: #166534; }
        .kw-nein { background: #fee2e2; color: #991b1b; }
        .kw-doch { background: #eff6ff; color: #1e40af; }

        .rule-note {
            margin-top: 0.75rem;
            font-size: 0.88rem;
            padding: 0.6rem 0.8rem;
            background: #fefce8;
            border-left: 3px solid #eab308;
            border-radius: 0 8px 8px 0;
        }

        /* Exercise list */
        .quiz-title {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 0.25rem;
        }

        .ex-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .ex-row {
            padding: 0.85rem 1rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 12px;
            transition: border-color 0.15s, background 0.15s;
        }

        .ex-row.correct { border-color: #10b981; background: #f0fdf4; }
        .ex-row.wrong   { border-color: #ef4444; background: #fef2f2; }

        .ex-q {
            display: flex;
            gap: 0.4rem;
            margin: 0 0 0.3rem;
        }

        .ex-num {
            font-weight: 700;
            color: #9ca3af;
            flex-shrink: 0;
        }

        .ex-question { font-weight: 600; }

        .ex-reply {
            margin: 0 0 0.6rem;
            font-size: 1rem;
            color: var(--color-text);
        }

        .ex-options {
            display: flex;
            gap: 0.5rem;
        }

        .opt-btn {
            padding: 0.45rem 1.1rem;
            border: 1.5px solid #d1d5db;
            border-radius: 20px;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            background: transparent;
            color: #374151;
            transition: background 0.12s, border-color 0.12s;
        }

        .opt-btn:hover:not(:disabled) { background: #f3f4f6; }
        .opt-btn:disabled { cursor: default; opacity: 0.7; }

        .opt-btn.chosen-correct {
            background: #dcfce7;
            border-color: #10b981;
            color: #166534;
        }

        .opt-btn.chosen-wrong {
            background: #fee2e2;
            border-color: #ef4444;
            color: #991b1b;
        }

        .opt-btn.reveal-correct {
            background: #dcfce7;
            border-color: #10b981;
            color: #166534;
        }

        .ex-feedback {
            margin: 0.4rem 0 0;
            font-size: 0.88rem;
            font-weight: 600;
            min-height: 1.2em;
        }

        .ex-hint {
            margin: 0.2rem 0 0;
            font-size: 0.78rem;
            display: none;
        }

        .ex-row.wrong .ex-hint,
        .ex-row.correct .ex-hint {
            display: block;
        }

        /* Actions */
        .actions { margin-top: 0.75rem; }

        .button-reset {
            padding: 0.6rem 1.2rem;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            cursor: pointer;
            background: transparent;
            color: #374151;
        }

        .result {
            margin-top: 0.5rem;
            font-size: 1.05rem;
            font-weight: 700;
            min-height: 1.4em;
        }
    </style>

    <script>
        if (!localStorage.getItem("session")) {
            window.location.replace("/login");
        }

        const list   = document.querySelector("#ex-list");
        const result = document.querySelector("#result");
        const reset  = document.querySelector("#reset-btn");

        if (
            !(list   instanceof HTMLDivElement)      ||
            !(result instanceof HTMLParagraphElement) ||
            !(reset  instanceof HTMLButtonElement)
        ) throw new Error("Missing elements");

        let answered = 0;
        let score    = 0;
        const total  = list.querySelectorAll(".ex-row").length;

        list.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest(".opt-btn");
            if (!(btn instanceof HTMLButtonElement) || btn.disabled) return;

            const row = btn.closest(".ex-row");
            if (!(row instanceof HTMLDivElement)) return;

            const correct  = row.dataset.answer ?? "";
            const chosen   = btn.dataset.opt   ?? "";
            const feedback = row.querySelector(".ex-feedback");

            // Disable all options in this row
            row.querySelectorAll(".opt-btn").forEach((b) => {
                if (b instanceof HTMLButtonElement) b.disabled = true;
            });

            if (chosen === correct) {
                score++;
                row.classList.add("correct");
                btn.classList.add("chosen-correct");
                if (feedback instanceof HTMLParagraphElement)
                    feedback.textContent = "✅ Richtig!";
            } else {
                row.classList.add("wrong");
                btn.classList.add("chosen-wrong");
                // Highlight correct answer
                row.querySelectorAll(".opt-btn").forEach((b) => {
                    if (b instanceof HTMLButtonElement && b.dataset.opt === correct)
                        b.classList.add("reveal-correct");
                });
                if (feedback instanceof HTMLParagraphElement)
                    feedback.textContent = `❌ Richtige Antwort: ${correct}`;
            }

            answered++;
            result.textContent = `${answered} / ${total} beantwortet · ${score} richtig`;

            if (answered === total) {
                result.textContent =
                    `Fertig! ${score} von ${total} richtig (${Math.round((score / total) * 100)}%).`;
            }
        });

        reset.addEventListener("click", () => {
            answered = 0;
            score    = 0;
            result.textContent = "";
            list.querySelectorAll(".ex-row").forEach((row) => {
                if (!(row instanceof HTMLDivElement)) return;
                row.classList.remove("correct", "wrong");
                const feedback = row.querySelector(".ex-feedback");
                if (feedback instanceof HTMLParagraphElement) feedback.textContent = "";
                row.querySelectorAll(".opt-btn").forEach((b) => {
                    if (!(b instanceof HTMLButtonElement)) return;
                    b.disabled = false;
                    b.classList.remove("chosen-correct", "chosen-wrong", "reveal-correct");
                });
            });
        });
    </script>
</Layout>