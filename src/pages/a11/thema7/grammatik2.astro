---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ActivitesList from "@/components/ActivitesList.astro";
import Card from "@/components/Card.astro";
import TagGrammatik from "@/components/Tags/TagGrammatik.astro";
import TagWortschatz from "@/components/Tags/TagWortschatz.astro";
import "@/styles/page.css";
import "@/styles/tables.css";
---

<Layout>
    <Header />

    <div class="grid grid-cols-1 md:grid-cols-[300px_1fr]">
        <ActivitesList open={7} />

        <main class="page bg-background">
            <Card>
                <h1>Grammatik</h1>
                <p class="subtitle text-indications">
                    Al final de esta unidad podrás saludar, presentarte y
                    preguntar por el origen de las personas.
                </p>

                <div class="sections">
                    <div class="section">
                        <TagGrammatik />
                        <div class="vocab-group">
                            <h4>Nomen + Nomen</h4>
                            <table class="vocab-table">
                                <thead>
                                    <tr><th>Deutsch</th><th>Español</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>das Bett + die Decke</td>
                                        <td>die Bettdecke</td>
                                    </tr>
                                    <tr>
                                        <td>die Orangen + der Saft</td>
                                        <td>der Orangensaft</td>
                                    </tr>
                                    <tr>
                                        <td>das Auto + die Tür</td>
                                        <td>die Autotür</td>
                                    </tr>
                                    <tr>
                                        <td>der Kaffee + die Tasse</td>
                                        <td>der Kaffeetasse</td>
                                    </tr>
                                    <tr>
                                        <td>der Fuß + der Ball + das Spiel</td>
                                        <td>das Fußballspiel</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </Card>
        </main>
    </div>

    <style>
        .obj-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .obj-list li {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.95rem;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-blue {
            background: #3b82f6;
        }

        .vocab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .vocab-group h4 {
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 0.5rem 0;
        }

        @media (max-width: 600px) {
            .vocab-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Layout>
